{
  "name": "@saf-site/cli",
  "version": "0.1.0",
  "description": "CLI tool for managing SAF site content and database",
  "type": "module",
  "bin": {
    "saf-site": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci:check": "pnpm typecheck && pnpm lint:check && pnpm test:run",
    "ci:security": "pnpm audit --audit-level=high"
  },
  "keywords": [
    "mitre",
    "saf",
    "cli",
    "content-management"
  ],
  "author": "MITRE SAF Team",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "pocketbase": "^0.26.9",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@types/node": "^25.9.5",
    "@types/wait-on": "^5.3.4",
    "@vitest/coverage-v8": "^4.1.11",
    "execa": "^9.6.1",
    "interactive-cli-tester": "^0.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
