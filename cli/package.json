{
  "name": "@saf-site/cli",
  "version": "0.1.0",
  "description": "CLI tool for managing SAF site content and database",
  "type": "module",
  "bin": {
    "saf-site": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci:check": "pnpm typecheck && pnpm lint:check && pnpm test:run",
    "ci:security": "pnpm audit --audit-level=high"
  },
  "keywords": [
    "mitre",
    "saf",
    "cli",
    "content-management"
  ],
  "author": "MITRE SAF Team",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "pocketbase": "^0.28.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^26.6.5",
    "@types/wait-on": "^5.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "execa": "^10.2.0",
    "interactive-cli-tester": "^0.3.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
